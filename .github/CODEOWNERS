/docs/audits/phase1-security-exceptions.md    @anassagd432

# --- Supply chain, CI, and release authority ---------------------------------
# Fork pull requests must not be able to reach write credentials, and no
# unreviewed ref may publish. Workflow and release-checker changes are therefore
# owner-reviewed.
/.github/                                     @anassagd432
/.github/CODEOWNERS                           @anassagd432
/scripts/openclaw-npm-release-check.ts        @anassagd432
/scripts/release-check.ts                     @anassagd432
