{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/environment/layout,_N_T_/dashboard/environment/page,_N_T_/dashboard/environment"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/environment/__PAGE__",
    "/dashboard/environment",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}