{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/console/layout,_N_T_/dashboard/console/page,_N_T_/dashboard/console"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/console/__PAGE__",
    "/dashboard/console",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}