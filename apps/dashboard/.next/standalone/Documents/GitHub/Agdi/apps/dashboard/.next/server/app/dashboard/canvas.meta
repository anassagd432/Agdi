{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/canvas/layout,_N_T_/dashboard/canvas/page,_N_T_/dashboard/canvas"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/canvas/__PAGE__",
    "/dashboard/canvas",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}