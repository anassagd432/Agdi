# ─────────────────────────────────────────────────────────────────────────────
#  Agdi Dev Stack — Environment Variables
#  Copy this file to .env.dev and fill in your real values.
#  This file is intentionally checked in with safe placeholder defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── Agdi Gateway + Dashboard Auth ────────────────────────────────────────────
# Shared token used by the Dashboard to authenticate WebSocket requests
# and as the dashboard login password.
# For production, generate a strong secret: openssl rand -hex 32
AGDI_GATEWAY_TOKEN=local-dev-token

# Optional: separate dashboard JWT signing secret (falls back to AGDI_GATEWAY_TOKEN)
# DASHBOARD_SECRET=

# Optional: Claude AI session key (leave blank to use other models)
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# ── AI Model Keys (add the ones you use) ─────────────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── n8n Credentials ──────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=agdi-local

# ── Dashboard Settings (optional) ────────────────────────────────────────────
# Override the WebSocket URL (default: ws://agdi-gateway:18789/ws in Docker,
# ws://127.0.0.1:18789/ws when running locally)
# NEXT_PUBLIC_WS_URL=ws://localhost:18789/ws
