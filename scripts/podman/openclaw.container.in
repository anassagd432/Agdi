# Agdi gateway — Podman Quadlet (rootless)
# Installed by setup-podman.sh into agdi's ~/.config/containers/systemd/
# {{AGDI_HOME}} is replaced at install time.

[Unit]
Description=Agdi gateway (rootless Podman)

[Container]
Image=agdi:local
ContainerName=agdi
UserNS=keep-id
Volume={{AGDI_HOME}}/.agdi:/home/node/.agdi
EnvironmentFile={{AGDI_HOME}}/.agdi/.env
Environment=HOME=/home/node
Environment=TERM=xterm-256color
PublishPort=18789:18789
PublishPort=18790:18790
Pull=never
Exec=node dist/index.js gateway --bind lan --port 18789

[Service]
TimeoutStartSec=300
Restart=on-failure

[Install]
WantedBy=default.target
